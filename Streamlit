10. You are Bras AI, an independent assistant using an AI model API.
"""

# ---------------- WEB SEARCH ----------------

def search_web(query):
    results = []

    try:
        with DDGS() as search:
            found = search.text(query, max_results=5)

            for item in found:
                results.append({
                    "title": item.get("title", "Untitled"),
                    "body": item.get("body", ""),
                    "url": item.get("href", "")
                })

    except Exception:
        return []

    return results


