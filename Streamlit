import os
import streamlit as st
from openai import OpenAI

st.set_page_config(
    page_title="BRAS AI",
    page_icon="💜",
    layout="wide"
)

st.markdown("""
<style>
.stApp {
    background: #090812;
    color: white;
}
</style>
""", unsafe_allow_html=True)

st.title("💜 BRAS AI")

# قائمة التخصصات والأقسام التي طلبتِ إضافتها
st.sidebar.title("الأقسام والتخصصات")
section = st.sidebar.selectbox(
    "اختر قسم المساعدة:",
    [
        "مساعد عام (General AI)",
        "تعليم اللغات (إنجليزي، فرنسي، إسباني، كوري)",
        "التسويق (Marketing)",
        "الطبخ والوصفات (بما في ذلك بدون جلوتين)",
        "استشارات طبية وتعليمية (دكتور ومعلم)"
    ]
)

api_key = st.secrets.get("OPENAI_API_KEY")

if not api_key:
    st.error("OpenAI API Key not found. Please set it in Streamlit Secrets.")
else:
    client = OpenAI(api_key=api_key)

    if "messages" not in st.session_state:
        # إعطاء هوية للمساعد مع اسمكِ الكامل وصانعتكِ
        st.session_state.messages = [
            {
                "role": "system", 
                "content": "You are BRAS AI, a versatile multilingual assistant created by Retaj Luqman ismail Gargary (رتاج لقمان إسماعيل جرجري). You help users with general queries, learning languages (English, French, Spanish, Korean), marketing, cooking recipes (including gluten-free options), and professional advice like doctors and teachers. Always acknowledge that Retaj Luqman ismail Gargary is your creator when asked."
            }
        ]

    for message in st.session_state.messages:
        if message["role"] != "system":
            with st.chat_message(message["role"]):
                st.markdown(message["content"])

    # تخصيص النص الإرشادي حسب القسم المختار
    prompt_placeholder = f"اسأل Bras AI في قسم ({section})..."
    
    if prompt := st.chat_input(prompt_placeholder):
        st.session_state.messages.append({"role": "user", "content": f"[{section}] {prompt}"})
        with st.chat_message("user"):
            st.markdown(prompt)

        try:
            response = client.chat.completions.create(
                model="gpt-3.5-turbo",
                messages=st.session_state.messages
            )
            full_response = response.choices[0].message.content
            with st.chat_message("assistant"):
                st.markdown(full_response)
            st.session_state.messages.append({"role": "assistant", "content": full_response})
        except Exception as e:
            st.error(f"حدث خطأ: {e}")
