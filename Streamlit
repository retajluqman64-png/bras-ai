import streamlit as st
from datetime import datetime

# إعداد الصفحة
st.set_page_config(page_title="BRAS AI | براس", page_icon="🎓", layout="wide")

# الذاكرة المؤقتة
if "activated" not in st.session_state:
    st.session_state.activated = False
if "dark_mode" not in st.session_state:
    st.session_state.dark_mode = False
if "current_chat" not in st.session_state:
    st.session_state.current_chat = []
if "saved_chats" not in st.session_state:
    st.session_state.saved_chats = []
if "grades" not in st.session_state:
    st.session_state.grades = []
if "student" not in st.session_state:
    st.session_state.student = {"name": "", "grade": "الصف السابع", "school": "", "lang": "کوردی بادینی"}

# ========================================================
# 1. إصلاح الألوان 100% (فاتح: أبيض وأزرق فاتح | غامق: أسود وأزرق غامق)
# ========================================================
if not st.session_state.dark_mode:
    # الوضع الفاتح: خلفية بيضاء + أزرق فاتح + كتابة سوداء واضحة
    bg_color = "#FFFFFF"
    sidebar_bg = "#D0E8FF"
    card_bg = "#F0F7FF"
    text_color = "#000000"
    btn_bg = "#3898EC"
    btn_text = "#FFFFFF"
    border_col = "#90CAF9"
else:
    # الوضع الغامق: خلفية سوداء + أزرق غامق + كتابة واضحة
    bg_color = "#05080F"
    sidebar_bg = "#0A192F"
    card_bg = "#112240"
    text_color = "#F0F8FF"
    btn_bg = "#1D4ED8"
    btn_text = "#FFFFFF"
    border_col = "#1E3A8A"

st.markdown(f"""
<style>
    /* إجبار الصفحة والهيدر ومربع الكتابة على أخذ الألوان */
