        width: 100%;
    }}
    /* الصناديق والبطاقات */
    .box-card {{
        background-color: {card_bg};
        border: 2px solid {border_col};
        padding: 15px;
        border-radius: 12px;
        margin-bottom: 15px;
    }}
    /* حقول الإدخال */
    input, textarea, select {{
        background-color: {card_bg} !important;
        color: {text_color} !important;
        border: 1px solid {border_col} !important;
    }}
</style>
""", unsafe_allow_html=True)

# زر تبديل المظهر في الأعلى دائماً ليكون واضحاً
col_top1, col_top2 = st.columns([4, 1])
with col_top2:
    mode_label = "🌙 تفعيل الوضع الغامق" if not st.session_state.dark_mode else "☀️ تفعيل الوضع الفاتح"
    if st.button(mode_label):
        st.session_state.dark_mode = not st.session_state.dark_mode
        st.rerun()

# ========================================================
# 2. شاشة البداية (الشروط + الأسعار + الدفع كي كارد فقط)
# ========================================================
if not st.session_state.activated:
    st.title("🎓 أهلاً بك في تطبيق براس (BRAS AI)")
    st.write("المنصة الذكية الشاملة لطلاب إقليم كوردستان - مناهج 2026")
    
    c1, c2 = st.columns(2)
    with c1:
        st.markdown(f"""
        <div class="box-card">
            <h3>📜 شروط الاستخدام والأسعار</h3>
            <ul>
                <li>الاشتراك مخصص لطالب واحد فقط.</li>
                <li>يشمل جميع الصفوف ومواد 2026 المحدثة.</li>
                <li><b>سعر الكورس الواحد (فصل دراسي):</b> 15 دولار.</li>
                <li><b>سعر الكورسين (سنة كاملة):</b> 30 دولار.</li>
            </ul>
        </div>
        """, unsafe_allow_html=True)
        
    with c2:
        st.markdown(f"""
        <div class="box-card">
            <h3>💳 طريقة الدفع (بطاقة كي كارد Qi Card فقط)</h3>
            <p>1. حوّل مبلغ الاشتراك إلى رقم بطاقة الكي كارد:</p>
            <h4><code>XXXX - XXXX - XXXX - XXXX</code></h4>
            <p>2. أرسل صورة الوصل للإدارة لاستلام كود التفعيل.</p>
        </div>
        """, unsafe_allow_html=True)
        
        code = st.text_input("🔑 أدخل كود التفعيل للدخول:", type="password", placeholder="اكتب: 2026")
        if st.button("دخول إلى براس 🚀"):
            if code == "2026":
                st.session_state.activated = True
                st.rerun()
            else:
                st.error("الكود غير صحيح! جربي كتابة 2026 للتجربة.")
    st.stop()

# ========================================================
# 3. القائمة الجانبية داخل التطبيق
# ========================================================
with st.sidebar:
    st.title("🎓 BRAS AI")
    st.session_state.student["lang"] = st.selectbox("🌐 اختر اللغة:", ["کوردی بادینی", "کوردی سۆرانی", "العربية"])
    st.divider()
    page = st.radio("📌 الأقسام:", [
        "💬 اسأل براس (الشرح والصوت)",
        "📚 كتب 2026 والحاسوب الجديد",
        "📝 بنك الأسئلة والوزاري",
        "🎯 الكويزات وسجل الدرجات",
        "🎥 يوتيوب وهەڵسەنگاندن والعطل",
        "🗂️ الدردشات المحفوظة",
        "👤 معلومات الطالب والحساب"
    ])

# ========================================================
# 4. صفحات التطبيق
# ========================================================
if page == "💬 اسأل براس (الشرح والصوت)":
    c_title, c_btn = st.columns([3, 1])
    with c_title:
        st.header(f"💬 المساعد الذكي ({st.session_state.student['lang']})")
    with c_btn:
        if st.button("➕ دردشة جديدة"):
            if st.session_state.current_chat:
                st.session_state.saved_chats.append({
                    "date": datetime.now().strftime("%Y-%m-%d %H:%M"),
                    "chat": list(st.session_state.current_chat)
                })
                st.session_state.current_chat = []
                st.rerun()

    # أدوات الصوت ومشاركة الشاشة
    with st.expander("🎙️ أدوات الصوت، مشاركة الشاشة، والمشاركة"):
        col_a, col_b, col_c = st.columns(3)
        with col_a:
            st.audio_input("🎤 تسجيل سؤال صوتي")
        with col_b:
            st.file_uploader("🖥️ مشاركة شاشة أو صفحة كتاب", type=["png", "jpg", "pdf"])
        with col_c:
            st.checkbox("🔊 تفعيل الجواب الصوتي", value=True)
            st.button("📤 مشاركة الشرح")

    for msg in st.session_state.current_chat:
        with st.chat_message(msg["role"]):
            st.write(msg["content"])

    prompt = st.chat_input("اكتب سؤالك هنا...")
    if prompt:
        st.session_state.current_chat.append({"role": "user", "content": prompt})
        reply = f"**شرح براس الواضح:**\nتفضل شرح موضوع *({prompt})* حسب منهج 2026.\n\n🎥 **رابط يوتيوب للشرح:** [اضغط هنا لمشاهدة الفيديو](https://youtube.com)"
        st.session_state.current_chat.append({"role": "assistant", "content": reply})
        st.rerun()

elif page == "📚 كتب 2026 والحاسوب الجديد":
    st.header("📚 مكتبة كتب إقليم كوردستان - آخر إصدار 2026")
    grade = st.selectbox("اختر الصف:", ["الأول", "الثاني", "الثالث", "الرابع", "الخامس", "السادس", "السابع", "الثامن", "التاسع", "العاشر", "الحادي عشر", "الثاني عشر"], index=6)
    subject = st.selectbox("اختر المادة:", ["💻 الحاسوب الجديد (Computer - English)", "الرياضيات", "العلوم", "اللغة الإنجليزية", "اللغة الكوردية", "اللغة العربية", "الاجتماعيات"])
    
    st.markdown(f"<div class='box-card'><b>كتاب {subject} - الصف {grade} (طبعة 2026):</b><br>محتوى الكتاب متوفر هنا للنسخ والدراسة المباشرة.</div>", unsafe_allow_html=True)
    st.text_area("نص من الكتاب (قابل للنسخ):", "Unit 1: Introduction to Computer Science (2026 Edition)...", height=180)

elif page == "📝 بنك الأسئلة والوزاري":
    st.header("📝 الأسئلة والامتحانات")
    t1, t2 = st.tabs(["🤖 أسئلة يصنعها براس", "🏫 أسئلة المدارس والوزاري (السنوات السابقة)"])
    with t1:
        lesson = st.text_input("اكتب اسم الدرس لصنع أسئلة متوقعة:")
        if st.button("اصنع الأسئلة ✨"):
            st.write(f"أسئلة مقترحة حول **{lesson}**:\n1. عرف المصطلحات...\n2. اختر الإجابة الصحيحة...")
    with t2:
        st.selectbox("اختر السنة:", ["2025-2026", "2024-2025", "2023-2024"])
        st.text_area("نموذج أسئلة وزارية / مدرسية (قابل للنسخ):", "س1: أجب عن جميع الفروع التالية...", height=150)

elif page == "🎯 الكويزات وسجل الدرجات":
    st.header("🎯 الكويزات وحساب النسبة المئوية")
    ans = st.radio("سؤال سريع: بأي لغة يُدرّس منهج الحاسوب الجديد في كوردستان 2026؟", ["اللغة الإنجليزية", "اللغة العربية"])
    if st.button("إنهاء الكويز وحفظ الدرجة 📊"):
        score = 100 if ans == "اللغة الإنجليزية" else 0
        st.session_state.grades.append({"التاريخ": datetime.now().strftime("%Y-%m-%d"), "المادة": "Computer 2026", "الدرجة": score, "النسبة": f"{score}%"})
        st.success(f"درجتك: {score}/100 | نسبتك: {score}%")
        
    st.subheader("🏆 سجل درجاتك المسجلة:")
    if st.session_state.grades:
        st.table(st.session_state.grades)

elif page == "🎥 يوتيوب وهەڵسەنگاندن والعطل":
    st.header("🎥 بوابة الطالب والأخبار")
    c1, c2 = st.columns(2)
    with c1:
        st.markdown("""
        <div class="box-card">
            <h3>📊 كيف تفتح درجاتك في هەڵسەنگاندن وقوتابخانەکەم؟</h3>
            <p>1. ادخل إلى تطبيق <b>قوتابخانەکەم (Qutabxanakam)</b>.</p>
            <p>2. أدخل كود الطالب والرمز السري الخاص بمدرستك.</p>
            <p>3. اضغط على قسم (هەڵسەنگاندن / التقييمات) لمشاهدة درجاتك.</p>
        </div>
        """, unsafe_allow_html=True)
        st.link_button("🔗 فتح يوتيوب للشروحات", "https://youtube.com")
    with c2:
        st.markdown("""
        <div class="box-card">
            <h3>📅 أخبار العطل وجداول الامتحانات المدرسية</h3>
            <p>• لا توجد عطلة رسمية هذا الأسبوع.</p>
            <p>• سيتم تحديث جدول امتحانات نصف السنة فور صدوره من التربية.</p>
        </div>
        """, unsafe_allow_html=True)

elif page == "🗂️ الدردشات المحفوظة":
    st.header("🗂️ الدروس السابقة المحفوظة")
    if not st.session_state.saved_chats:
        st.write("لا توجد دردشات محفوظة بعد. اضغط على (دردشة جديدة) لحفظ درسك الحالي هنا.")
    for item in st.session_state.saved_chats:
        with st.expander(f"📁 درس بتاريخ {item['date']}"):
            for m in item["chat"]:
                st.write(f"**{m['role']}:** {m['content']}")

elif page == "👤 معلومات الطالب والحساب":
    st.header("👤 الملف الشخصي للطالب")
    col1, col2 = st.columns(2)
    with col1:
        st.subheader("🎒 معلومات الطالب (منفصلة عن الحساب)")
        st.session_state.student["name"] = st.text_input("اسم الطالب:", st.session_state.student["name"])
        st.session_state.student["grade"] = st.selectbox("الصف:", ["السابع", "الثامن", "التاسع", "العاشر", "الحادي عشر", "الثاني عشر"])
        st.session_state.student["school"] = st.text_input("المدرسة:", st.session_state.student["school"])
        if st.button("حفظ معلومات الطالب 💾"):
            st.success("تم الحفظ!")
    with col2:
        st.subheader("💳 معلومات الحساب والاشتراك")
        st.write("**حالة الحساب:** مفعل ✅")
        st.write("**الباقة:** كورس واحد (15$)")
        st.write("**طريقة الدفع:** كي كارد (Qi Card)")
